# What Leo is listening to — read by app/api/now-playing/route.ts.
#
# Get the first two from https://developer.spotify.com/dashboard, then run:
#   node scripts/spotify-refresh-token.mjs <client_id> <client_secret>
# which prints all three ready to paste.
#
# Copy this file to .env.local for local development. On Vercel, set the same
# three as environment variables for Production, Preview and Development.
#
# Leave them unset and the Music card simply shows nothing — the site builds
# and runs exactly as before.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
